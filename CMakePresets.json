{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Native Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "workspace-tests",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/workspace",
      "cacheVariables": {
        "NEBULA_BUILD_APP": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "workspace-tests",
      "configurePreset": "workspace-tests"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "workspace-tests",
      "configurePreset": "workspace-tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
